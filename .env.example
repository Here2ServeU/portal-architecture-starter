# Copy this file to .env.local and fill in the values from your OWN Supabase
# project (Project Settings -> API). Never commit .env.local.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret — server-only. Used by lib/supabase/admin.ts to bypass RLS for
# trusted, server-side reads/writes (the pattern this starter demonstrates).
# NEVER expose this to the browser or commit it anywhere.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
